# ==============================================================================
# DocuVortex — Production Git Ignore Configuration
# ==============================================================================

# ─── 1. Secrets & Environment (CRITICAL — NEVER COMMIT) ───────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
.env.docker

# ─── 2. Python Bytecode, Caches & Packaging ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ─── 3. Virtual Environments & Runtimes ───────────────────────────────────────
.venv/
venv/
venv*/
env/
env*/
ENV/
Yenv/
eval-env/
.agents/
.gemini/

# ─── 4. Local Data, Storage & Vector Databases ───────────────────────────────
data/uploads/
data/memory/
data/qdrant_storage/
qdrant_storage/
*.sqlite3
*.sqlite3-journal
*.db
*.ses
:memory:.ses

# ─── 5. Logs & Runtime Artifacts ──────────────────────────────────────────────
logs/
*.log
*.tmp

# ─── 6. Evaluation Large Binaries & Generated Reports ─────────────────────────
Evaluation/data/*.pdf
Evaluation/*_results.json
Evaluation/reports/md_debug/
Evaluation/Generation_eval/reports/
Evaluation/Pipeline_eval/reports/

# Explicitly ensure Golden Datasets & Baseline Benchmarks ARE tracked:
!Evaluation/golden_dataset.json
!Evaluation/Generation_eval/golden_dataset.json
!Evaluation/Pipeline_eval/golden_dataset.json
!Evaluation/reports/baseline_retriever.json
!Evaluation/reports/README.md
!Evaluation/Eval_Check.md

# ─── 7. Temporary & Scratch Files ─────────────────────────────────────────────
powershell.cmd
scripts/
test.py
test.csv
test.ipynb
check_db.py
wipe_data.py
evaluation_results.csv
endpoint_regression_check.py
UPDATE_REPORT.txt
walkthrough.md
input/

# ─── 8. Documentation (Kept locally in workspace, untracked from Git) ─────────
MD-FILES/
documents/

# ─── 9. IDE & OS Artifacts ────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
.cursorignore
.cursorindexingignore
.ipynb_checkpoints/
*.ipynb_checkpoints

Evaluation/
data/