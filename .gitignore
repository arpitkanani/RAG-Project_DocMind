# ==============================================================================
# DocuVortex Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (NEVER commit secrets to version control)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.cert

# ------------------------------------------------------------------------------
# 2. Python Bytecode & Runtime Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
venv/
venv*/
.venv/
env/
env*/
ENV/
eval-env/

# ------------------------------------------------------------------------------
# 4. Local Data, Vector Databases & Ephemeral Artifacts
# ------------------------------------------------------------------------------
data/
qdrant_storage/
*.sqlite3
*.sqlite3-journal
*.db
*.ses
:memory:.ses

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Debug Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
UPDATE_REPORT.txt
evaluation_results.csv
test.csv

# ------------------------------------------------------------------------------
# 6. Testing & Type Checker Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------------------------------------------------------
# 7. IDE & OS Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
.cursorignore
.cursorindexingignore

# ------------------------------------------------------------------------------
# NOTE: The following critical project files and folders MUST be tracked:
# - MD-FILES/              (Complete system documentation)
# - database/init.sql      (PostgreSQL relational schema)
# - seed_user.py           (API key & user provisioning CLI)
# - check_db.py            (Database health & statistics inspector)
# - wipe_data.py           (Development data reset utility)
# - config/config.yaml     (Application default configuration)
# ==============================================================================

check_db.py
test.py
wipe_data.py
MD-FILES/
walkthrough.md