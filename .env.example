
# ─── Security / Auth ──────────────────────────────────────────────────────────
# Secret key for signing JWT tokens and session cookies (generate a random 64-char string)
# e.g., python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_64_character_secret_key_here
ENV=dev
# CORS allowed origins (comma-separated). Set your production domain in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── LLM Providers (Generation Cascade) ────────────────────────────────────────
# 1. Groq (Primary — Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_AGENT_MODEL=openai/gpt-oss-20b

# 2. Google Gemini (Secondary Fallback — Free Tier)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 3. Azure OpenAI Chat (Tertiary Fallback)
AZURE_OPENAI_MODEL_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_MODEL_API_KEY=your_azure_openai_chat_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-nano
AZURE_OPENAI_MODEL_VERSION=2026-03-17

# ─── Text Embeddings (Primary) ─────────────────────────────────────────────────
# Azure OpenAI text-embedding-3-small (1536 dims)
AZURE_OPENAI_EMBEDDING_API_KEY=your_azure_openai_embedding_api_key_here
AZURE_OPENAI_EMBEDDING_ENDPOINT="get this from azure"
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# ─── PostgreSQL Database (Supabase) ───────────────────────────────────────────
# Transaction pooler (port 6543) for standard queries
DATABASE_URL=Get this from supabase and paste here
# Direct connection (port 5432) — REQUIRED for LangGraph checkpointer (prepared statements)
LANGGRAPH_DATABASE_URL=get this from supabase and paste here

# Local Docker Postgres Fallbacks (used only if DATABASE_URL is unset)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docmind
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=docmind

# ─── Vector Database (Qdrant Cloud) ───────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ─── External Tools (Fallback Services) ───────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ─── Tracing & Observability (LangSmith) ───────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=DocuVortex-Prod

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=DocuVortex-Prod
